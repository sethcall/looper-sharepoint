# Values for the access request. Copy to local/access-request.env (gitignored) and fill in; never commit the real one.
# `just access-request` builds dist/<org>-access-request.docx and dist/<org>-access-request-email.txt from them.

ORG=Contoso
APP_NAME=Contoso SharePoint Sync
REQUESTER=Alex Example
REQUESTER_ROLE=Engineering
# Licensed users in the tenant (sets SharePoint's request budget tier)
LICENSES=20000
# Pilot size, and libraries each person syncs
PILOT_USERS=100
LIBRARIES_PER_USER=3

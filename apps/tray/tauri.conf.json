{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Looper SharePoint",
  "mainBinaryName": "looper-sharepoint-tray",
  "identifier": "dev.looper-sharepoint.tray",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "public.app-category.productivity",
    "copyright": "Copyright \u00a9 2026 Michael Seth Call",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
